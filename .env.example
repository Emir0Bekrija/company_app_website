# Public URL of this website, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.navitecs.com

# Public URL of the Navitecs Flow app. While this is empty, "Create your workspace"
# goes to the contact page instead of a dead link.
NEXT_PUBLIC_APP_URL=

# Contact form delivery. While these are empty the form shows the contact address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=info@navitecs.com
CONTACT_FROM=
